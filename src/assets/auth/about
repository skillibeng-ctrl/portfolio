                  Alex Chen
                </span>
              </h1>

              <h2 className="text-2xl text-gray-300">
                Full-Stack Developer & UI/UX Enthusiast
              </h2>

              <p className="text-lg text-gray-400 leading-relaxed">
                {profileData.bio}
