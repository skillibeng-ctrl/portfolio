              What clients and colleagues say about working with me.
            </p>
          </motion.div>

          <div className="grid md:grid-cols-3 gap-6">
            {testimonialsData.map((testimonial, index) => (
              <TestimonialCard key={index} testimonial={testimonial} index={index} />
            ))}
          </div>
        </section>

        {/* Blog Section */}
        <section className="py-20">
          <motion.div variants={itemVariants} className="text-center mb-16">
            <h2 className="text-4xl font-bold mb-4">
              Latest <span className="text-transparent bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text">Articles</span>
            </h2>
            <p className="text-gray-400 max-w-2xl mx-auto">
              Thoughts, tutorials, and insights about web development and design.
            </p>
          </motion.div>

          <div className="grid md:grid-cols-3 gap-6">
            {blogPostsData.map((post, index) => (
              <BlogCard key={index} post={post} index={index} />
            ))}
          </div>
        </section>

        {/* Contact Section */}
        <section id="contact" className="py-20">
          <motion.div variants={itemVariants} className="text-center mb-16">
            <h2 className="text-4xl font-bold mb-4">
              Get In <span className="text-transparent bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text">Touch</span>
            </h2>
            <p className="text-gray-400 max-w-2xl mx-auto">
              Have a project in mind? Let's discuss how I can help you bring your ideas to life.
